# ============================================================
# Portfolio — Docker Environment Configuration
# Copy this file to `.env` in the repository root and adjust.
# This file is used by docker-compose.yml.
# ============================================================

# --- PostgreSQL Database ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=change-me-postgres-password

# --- Backend Server ---
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# --- JWT Secrets (CHANGE THESE IN PRODUCTION) ---
JWT_ACCESS_SECRET=change-me-access-secret-docker
JWT_REFRESH_SECRET=change-me-refresh-secret-docker
JWT_ACCESS_SECRET_TTL=15m
JWT_REFRESH_SECRET_TTL_DAYS=7

# --- CORS ---
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# --- Admin Seed ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_MAX_SIZE_BYTES=5242880
STORAGE_ALLOWED_MIME_TYPES=application/pdf

# --- Analytics ---
VISITOR_HASH_SECRET=change-me-analytics-salt

# --- Frontend/Admin (browser-facing) ---
# These are used at build time for the React apps.
# They should point to the browser-accessible backend URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SITE_URL=http://localhost:3000

# --- Email (optional) ---
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASS=your-smtp-password
