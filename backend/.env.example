# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_SECRET_TTL=15m
JWT_REFRESH_SECRET_TTL_DAYS=7

# Cookies
REFRESH_TOKEN_COOKIE_NAME=portfolio_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin seed (used by prisma/seed.js)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Storage (LocalStorageProvider)
STORAGE_DRIVER=local
STORAGE_LOCAL_UPLOAD_DIR=uploads
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:5001/api/v1
STORAGE_MAX_SIZE_BYTES=5242880
STORAGE_ALLOWED_MIME_TYPES=application/pdf

# Email (transactional notifications)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Portfolio <admin@example.com>
CONTACT_NOTIFICATION_EMAIL=admin@example.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASS=your-smtp-password

# Contact rate limiting
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
