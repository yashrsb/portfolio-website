generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ProjectStatus {
  live
  wip
  archived
}

enum SkillCategory {
  languages
  frontend
  backend
  databases
  cloud
  tools
}

enum ContactMessageStatus {
  new
  read
  archived
}

enum ContactEmailStatus {
  pending
  sent
  failed
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Profile {
  id              String   @id @default(uuid())
  name            String
  headline        String
  tagline         String
  bio             String
  interests       String[]
  goals           String[]
  strengths       String[]
  stats           Json
  contact         Json
  resumeUrl       String   @default("#")
  profileImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id               String        @id @default(uuid())
  slug             String        @unique
  title            String
  description      String
  summary          String?
  imageUrl         String?
  githubUrl        String?
  demoUrl          String?
  status           ProjectStatus @default(live)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0)
  tags             String[]
  features         String[]      @default([])
  techStack        Json?
  challenges       String[]      @default([])
  lessonsLearned   String[]      @default([])
  architecture     String?
  architectureImage String?
  screenshots      Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([featured, displayOrder])
  @@index([status])
  analyticsEvents AnalyticsEvent[]
}

model Experience {
  id               String    @id @default(uuid())
  company          String
  companyWebsite   String?
  role             String
  startDate        DateTime
  endDate          DateTime?
  current          Boolean   @default(false)
  location         String
  description      String
  technologies     String[]
  responsibilities String[]
  achievements     String[]
  displayOrder     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([displayOrder])
}

model Skill {
  id           String        @id @default(uuid())
  name         String
  category     SkillCategory
  proficiency  Int
  icon         String
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name, category])
  @@index([category, displayOrder])
}

model Education {
  id           String   @id @default(uuid())
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int
  grade        String?
  highlights   String[]
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

model Certificate {
  id           String   @id @default(uuid())
  name         String
  issuer       String
  date         String
  url          String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

model Achievement {
  id           String   @id @default(uuid())
  title        String
  organization String
  year         Int
  description  String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

model SocialLink {
  id           String   @id @default(uuid())
  platform     String   @unique
  url          String
  icon         String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

model ContactMessage {
  id          String              @id @default(uuid())
  name        String
  email       String
  subject     String
  message     String
  status      ContactMessageStatus @default(new)
  createdAt   DateTime            @default(now())
  ipAddress   String?
  userAgent   String?
  emailStatus ContactEmailStatus  @default(pending)
  emailSentAt DateTime?
  emailError  String?

  @@index([status, createdAt])
  @@index([emailStatus])
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         UserRole       @default(EDITOR)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model ResumeFile {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  storagePath  String
  storedName   String
  url          String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storageKey])
}

model BlogPost {
  id             String        @id @default(uuid())
  slug           String        @unique
  title          String
  excerpt        String?
  content        String
  coverImage     String?
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  author         String?
  featured       Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  categoryId     String?
  category       BlogCategory?  @relation(fields: [categoryId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tags           BlogPostTag[]

  @@index([status, publishedAt])
  @@index([featured, publishedAt])
  @@index([categoryId])
  analyticsEvents AnalyticsEvent[]
}

model BlogCategory {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]

  @@index([slug])
}

model BlogTag {
  id        String        @id @default(uuid())
  slug      String        @unique
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  posts     BlogPostTag[]

  @@index([slug])
}

model BlogPostTag {
  id        String   @id @default(uuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId     String
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Analytics (Phase 13)
// ---------------------------------------------------------------------------

enum AnalyticsEventType {
  PAGE_VIEW
  PROJECT_VIEW
  PROJECT_CLICK
  BLOG_POST_VIEW
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum BrowserType {
  CHROME
  FIREFOX
  SAFARI
  EDGE
  OPERA
  OTHER
  UNKNOWN
}

enum OperatingSystem {
  WINDOWS
  MACOS
  LINUX
  ANDROID
  IOS
  OTHER
  UNKNOWN
}

model AnalyticsEvent {
  id           String              @id @default(uuid())
  eventType    AnalyticsEventType
  path         String
  projectId    String?
  blogPostId   String?
  visitorHash  String
  country      String?
  deviceType   DeviceType          @default(UNKNOWN)
  browser      BrowserType         @default(UNKNOWN)
  os           OperatingSystem     @default(UNKNOWN)
  referrer     String?
  metadata     Json?
  createdAt    DateTime            @default(now())

  project      Project?   @relation(fields: [projectId], references: [id])
  blogPost     BlogPost?  @relation(fields: [blogPostId], references: [id])

  @@index([createdAt])
  @@index([eventType])
  @@index([projectId])
  @@index([blogPostId])
  @@index([visitorHash])
  @@index([country])
  @@index([deviceType])
  @@index([browser])
  @@index([eventType, path])
}

