# ============================================================
# Portfolio — Central Environment Configuration
# Copy this file to `.env` in the backend directory and adjust.
# NEVER commit real secrets. Use strong random values in production.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_SECRET_TTL=15m
JWT_REFRESH_SECRET_TTL_DAYS=7

# --- Cookies ---
REFRESH_TOKEN_COOKIE_NAME=portfolio_refresh
# Set to true when serving over HTTPS in production
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAME_SITE=lax

# --- Admin seed (used by prisma/seed.js) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Storage (LocalStorageProvider) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_UPLOAD_DIR=uploads
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:5001/api/v1
STORAGE_MAX_SIZE_BYTES=5242880
STORAGE_ALLOWED_MIME_TYPES=application/pdf

# --- Frontend (Vite) ---
# frontend/.env and admin/.env
VITE_API_BASE_URL=http://localhost:5001/api/v1
